# docker-mailserver settings — copy to mailserver.env on the VPS (/opt/drogist-mail).
# No secrets live here; mailbox passwords are set per-account via `setup email add`.

OVERRIDE_HOSTNAME=mail.bedenwellnessflevoland.nl
LOG_LEVEL=info

# TLS — currently self-signed (test configuration). Switch to SSL_TYPE=letsencrypt
# (or manual certs) before production delivery; see README → TLS.
SSL_TYPE=self-signed
TLS_LEVEL=modern

ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0

ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1

ENABLE_POP3=0
ENABLE_IMAP=1

POSTMASTER_ADDRESS=postmaster@drogist.ai
REPORT_RECIPIENT=postmaster@drogist.ai
REPORT_SENDER=mailserver-drogist@drogist.ai
REPORT_INTERVAL=daily

ENABLE_UPDATE_CHECK=0
PERMIT_DOCKER=network
SPOOF_PROTECTION=1
